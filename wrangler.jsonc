{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gameslotpro-site",
  "main": "worker.js",
  "compatibility_date": "2026-09-10",

  "keep_vars": true,

  "vars": {
    "SUPABASE_URL": "https://esokqqqvfzntehuttiou.supabase.co"
  },

  "secrets": {
    "required": [
      "SUPABASE_SERVICE_KEY"
    ]
  },

  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/google-login"
    ]
  }
}
